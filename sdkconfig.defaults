# ESP32-S3 + 32MB Flash + Octal PSRAM
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="platform/partitions.csv"
CONFIG_SDGOODS_APP_SLOTS=4
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_MEMTEST is not set

CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_USE_SNAPSHOT=y

# 绘制缓冲放内部 SRAM（不要回退到 PSRAM：QSPI DMA 弹跳缓冲预算极小，会出现黑条/红线）
# CONFIG_LV_MEM_CUSTOM is not set

# BLE scan (Bluedroid, BLE-only)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# appdata 分区按 app_id 建目录（/appdata/<app_id>/），而 app_id 来自 IDF 的
# esp_app_desc_t.project_name —— 最长 32 字符，**远超 FAT 的 8.3 短名限制**。
# 不开长文件名时 f_mkdir("SDGOODS_EBADGE") 会返回 FR_INVALID_NAME ⇒ VFS 报 EINVAL ⇒
# 目录建不出来，app 的持久化数据静默落空（2026-09-19 真机抓到，见 SKILL 红线 ⑧）。
# LFN_HEAP：长名缓冲区按需从堆取（单次约 (MAX_LFN+1)*2 字节，用完即还），
# 不占栈也不常驻。MAX_LFN 取 64 足够（app_id ≤ 32 + 文件名）。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
